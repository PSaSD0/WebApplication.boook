@model IEnumerable<WebApplication.boook.Models.GuestBookEntry>

@{
    ViewData["Title"] = "Гостевая книга";
}

<h1>Гостевая книга</h1>

<p>
    <a asp-action="Create" class="btn btn-success">Добавить отзыв</a>
</p>

@if (!Model.Any())
{
    <div class="alert alert-info">Пока нет отзывов</div>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>Автор</th>
            <th>Текст</th>
            <th>Дата создания</th>
            <th>Действия</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Author</td>
                <td>@item.Text</td>
                <td>@item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Изменить</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Удалить</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}